# Server Environment Variables Example
PORT=8000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/veloura

# Clerk Authentication Credentials
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# CORS / Allowed Frontend Origin(s) - Comma-separated for multiple origins
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini Vision AI API Key
GEMINI_API_KEY=your_gemini_api_key
